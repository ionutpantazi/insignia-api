{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable launcher preferences, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "preferences"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "sections", "player"],
      "properties": {
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "size", "hourCycle", "showSeconds"],
          "properties": {
            "style": { "type": "string", "enum": ["digital", "analog"] },
            "size": { "type": "string", "enum": ["small", "medium", "large"] },
            "hourCycle": { "type": "string", "enum": ["h12", "h23"] },
            "showSeconds": { "type": "boolean" }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clock", "shortcuts", "player"],
          "properties": {
            "clock": { "$ref": "#/definitions/section" },
            "shortcuts": { "$ref": "#/definitions/section" },
            "player": { "$ref": "#/definitions/section" }
          }
        },
        "player": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection"],
          "properties": {
            "selection": { "type": "string", "enum": ["local", "spotify", "radio"] }
          }
        }
      }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "position"],
      "properties": {
        "visible": { "type": "boolean" },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
