{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable launcher preferences, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "preferences"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "positions", "showShortcuts", "musicPlayer"],
      "properties": {
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "sizePercent"],
          "properties": {
            "style": { "type": "string", "enum": ["digital", "analog"] },
            "sizePercent": { "type": "integer", "minimum": 50, "maximum": 200 }
          }
        },
        "positions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clock", "shortcuts", "actions", "music"],
          "properties": {
            "clock": { "$ref": "#/definitions/position" },
            "shortcuts": { "$ref": "#/definitions/position" },
            "actions": { "$ref": "#/definitions/position" },
            "music": { "$ref": "#/definitions/position" }
          }
        },
        "showShortcuts": { "type": "boolean" },
        "musicPlayer": {
          "type": "string",
          "enum": ["none", "local", "spotify", "radio"]
        }
      }
    }
  },
  "definitions": {
    "position": {
      "description": "Null selects automatic placement. Otherwise x and y are nonnegative integer dp offsets from the usable Home content's top-left to the section's top-left, retained even when hidden.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
