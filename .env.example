HOST=127.0.0.1
PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Server-only credential file outside the workspace. Never put this in Android.
GOOGLE_APPLICATION_CREDENTIALS=C:\server-secrets\firebase-service-account.json
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=insignia
MYSQL_USER=insignia_api
MYSQL_PASSWORD=replace-with-a-strong-password
# For a remote MySQL server, supply its trusted CA and enable TLS.
MYSQL_TLS=false
# MYSQL_SSL_CA_FILE=C:\server-secrets\mysql-ca.pem
