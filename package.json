{
  "name": "insignia-settings-backup-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.1",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
